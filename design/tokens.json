{
  "$description": "giri-skills shared design tokens (source of truth). Edit this file only, then run `python3 design/build_tokens.py` to regenerate tokens.css. Decided 2026-11-23.",
  "color": {
    "light": {
      "bg":            { "$type": "color", "$value": "#F4F5F7", "$description": "Page background (graphite)" },
      "surface":       { "$type": "color", "$value": "#FFFFFF", "$description": "Card and panel background" },
      "sunken":        { "$type": "color", "$value": "#ECEEF1", "$description": "Recessed areas: table header, code block" },
      "border":        { "$type": "color", "$value": "#E1E4E8", "$description": "Dividers, table rows, overlay edge" },
      "border-strong": { "$type": "color", "$value": "#C6CBD2", "$description": "Inputs and secondary buttons" },
      "text":          { "$type": "color", "$value": "#15181D", "$description": "Primary text" },
      "text-muted":    { "$type": "color", "$value": "#5B626D", "$description": "Secondary text, labels, placeholders" },
      "text-disabled": { "$type": "color", "$value": "#878E99", "$description": "Disabled controls only (3:1)" },
      "accent":        { "$type": "color", "$value": "#2B5CE6", "$description": "Cobalt. Primary button, chart marks, focus ring" },
      "on-accent":     { "$type": "color", "$value": "#FFFFFF", "$description": "Text on accent fill" },
      "accent-soft":   { "$type": "color", "$value": "#E8EEFD", "$description": "Selected tab or row background" },
      "accent-text":   { "$type": "color", "$value": "#2B5CE6", "$description": "Links, selected tab text" },
      "success-text":  { "$type": "color", "$value": "#17734A" },
      "success-bg":    { "$type": "color", "$value": "#DDF3E6" },
      "warning-text":  { "$type": "color", "$value": "#8A5A00" },
      "warning-bg":    { "$type": "color", "$value": "#FCEBC7" },
      "danger-text":   { "$type": "color", "$value": "#B42318" },
      "danger-bg":     { "$type": "color", "$value": "#FDE3DF" },
      "chart-1": { "$type": "color", "$value": "#2B5CE6", "$description": "Categorical slot 1, cobalt (light = vivid steps)" },
      "chart-2": { "$type": "color", "$value": "#EB6834", "$description": "Orange" },
      "chart-3": { "$type": "color", "$value": "#1BAF7A", "$description": "Aqua. Below 3:1 on white: table view required" },
      "chart-4": { "$type": "color", "$value": "#EDA100", "$description": "Yellow. Below 3:1 on white: table view required" },
      "chart-5": { "$type": "color", "$value": "#E87BA4", "$description": "Pink. Below 3:1 on white: table view required" },
      "chart-6": { "$type": "color", "$value": "#008300", "$description": "Green" },
      "chart-7": { "$type": "color", "$value": "#6250D6", "$description": "Violet" },
      "chart-8": { "$type": "color", "$value": "#E34948", "$description": "Red" },
      "scrim":   { "$type": "color", "$value": "#10182873", "$description": "Layer behind a dialog (navy, 45%)" }
    },
    "dark": {
      "bg":            { "$type": "color", "$value": "#0B1220", "$description": "Page background (slate)" },
      "surface":       { "$type": "color", "$value": "#111A2B" },
      "sunken":        { "$type": "color", "$value": "#080D18" },
      "border":        { "$type": "color", "$value": "#1F2A3D" },
      "border-strong": { "$type": "color", "$value": "#34425A" },
      "text":          { "$type": "color", "$value": "#E6ECF5" },
      "text-muted":    { "$type": "color", "$value": "#98A6BC" },
      "text-disabled": { "$type": "color", "$value": "#67758C" },
      "accent":        { "$type": "color", "$value": "#7FA4FF", "$description": "Light cobalt. White text fails 4.5:1 here, so on-accent is dark" },
      "on-accent":     { "$type": "color", "$value": "#0B1020" },
      "accent-soft":   { "$type": "color", "$value": "#1A2440" },
      "accent-text":   { "$type": "color", "$value": "#8EB0FF" },
      "success-text":  { "$type": "color", "$value": "#5FD39A" },
      "success-bg":    { "$type": "color", "$value": "#0F2A1C" },
      "warning-text":  { "$type": "color", "$value": "#F2B84B" },
      "warning-bg":    { "$type": "color", "$value": "#2E2208" },
      "danger-text":   { "$type": "color", "$value": "#FF8A80" },
      "danger-bg":     { "$type": "color", "$value": "#3A1512" },
      "chart-1": { "$type": "color", "$value": "#4F7FEA", "$description": "Cobalt (dark = muted steps). Not the UI accent: chart marks must stay in the dark lightness band" },
      "chart-2": { "$type": "color", "$value": "#C96A3A" },
      "chart-3": { "$type": "color", "$value": "#1F9C83" },
      "chart-4": { "$type": "color", "$value": "#B48A2A" },
      "chart-5": { "$type": "color", "$value": "#C7638F" },
      "chart-6": { "$type": "color", "$value": "#3E9A45" },
      "chart-7": { "$type": "color", "$value": "#8C7FE0" },
      "chart-8": { "$type": "color", "$value": "#D06464" },
      "scrim":   { "$type": "color", "$value": "#000000A3", "$description": "Black, 64%" }
    }
  },
  "shadow": {
    "light": {
      "overlay": { "$type": "shadow", "$description": "Floating layers only: menus, popovers, dialogs", "$value": [
        { "color": "#1018280F", "offsetX": "0px", "offsetY": "4px",  "blur": "8px",  "spread": "0px" },
        { "color": "#1018281F", "offsetX": "0px", "offsetY": "16px", "blur": "32px", "spread": "0px" }
      ] }
    },
    "dark": {
      "overlay": { "$type": "shadow", "$value": [
        { "color": "#00000073", "offsetX": "0px", "offsetY": "8px",  "blur": "16px", "spread": "0px" },
        { "color": "#00000080", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "0px" }
      ] }
    }
  },
  "font": {
    "$extensions": {
      "giri.stylesheet": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap"
    },
    "family": {
      "body": { "$type": "fontFamily", "$value": ["Inter", "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", "sans-serif"], "$description": "Inter for Latin and digits, Noto Sans KR for Hangul" },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Code, logs, IDs. Has no Hangul" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "text": {
    "display": { "$type": "typography", "$description": "KPI numbers", "$value": { "fontFamily": "{font.family.body}", "fontSize": "36px", "fontWeight": "{font.weight.bold}",     "lineHeight": 1.2,  "letterSpacing": "-0.025em" } },
    "h1":      { "$type": "typography", "$description": "Page title", "$value": { "fontFamily": "{font.family.body}", "fontSize": "24px", "fontWeight": "{font.weight.bold}",     "lineHeight": 1.3,  "letterSpacing": "-0.02em" } },
    "h2":      { "$type": "typography", "$description": "Section title", "$value": { "fontFamily": "{font.family.body}", "fontSize": "18px", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.4,  "letterSpacing": "-0.01em" } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "16px", "fontWeight": "{font.weight.regular}",  "lineHeight": 1.6,  "letterSpacing": "-0.005em" } },
    "small":   { "$type": "typography", "$description": "Tables, buttons, inputs, labels, timestamps", "$value": { "fontFamily": "{font.family.body}", "fontSize": "14px", "fontWeight": "{font.weight.regular}", "lineHeight": 1.6, "letterSpacing": "-0.005em" } }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "card":    { "$type": "dimension", "$value": "{space.6}",  "$description": "Padding inside a card" },
    "stack":   { "$type": "dimension", "$value": "{space.5}",  "$description": "Gap between elements in a section" },
    "section": { "$type": "dimension", "$value": "{space.12}", "$description": "Gap between sections" },
    "inline":  { "$type": "dimension", "$value": "{space.3}",  "$description": "Gap between buttons and inline items" },
    "cell-y":  { "$type": "dimension", "$value": "{space.4}",  "$description": "Table cell vertical padding" },
    "cell-x":  { "$type": "dimension", "$value": "{space.5}",  "$description": "Table cell horizontal padding" },
    "page":    { "$type": "dimension", "$value": "{space.10}", "$description": "Page padding" }
  },
  "size": {
    "control": { "$type": "dimension", "$value": "{space.10}", "$description": "Height of buttons, inputs, selects, tabs" },
    "icon-sm": { "$type": "dimension", "$value": "{space.4}", "$description": "Icons inside buttons, inputs, tables, menus" },
    "icon-md": { "$type": "dimension", "$value": "{space.5}", "$description": "Icons in alerts and dialog close buttons" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "6px",    "$description": "Buttons, tabs" },
    "input":   { "$type": "dimension", "$value": "6px",    "$description": "Inputs, selects" },
    "card":    { "$type": "dimension", "$value": "8px" },
    "overlay": { "$type": "dimension", "$value": "12px",   "$description": "Menus, popovers, dialogs" },
    "badge":   { "$type": "dimension", "$value": "9999px", "$description": "Fully rounded" }
  },
  "card": {
    "background": { "$value": "{color.surface}" },
    "border":     { "$value": "none", "$description": "Cards are separated by background only" },
    "shadow":     { "$value": "none" },
    "radius":     { "$value": "{radius.card}" },
    "padding":    { "$value": "{space.card}" }
  }
}
